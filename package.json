{
  "name": "loglens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "lint:js": "oxlint",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "format:rust": "cd src-tauri && cargo fmt --all",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "test:large-regression": "vitest run src/lib/logs/parser.test.ts src/test/runtime-harness.test.tsx",
    "bench:large-session": "LOG_LENS_LARGE_BENCH=1 vitest run src/lib/logs/large-session.benchmark.test.ts",
    "check:runtime-smoke": "vitest run src/test/runtime-harness.test.tsx && cd src-tauri && cargo test allow_file_access",
    "check:harness": "scripts/check-agent-harness-interface.sh && node scripts/check-agent-harness.mjs",
    "check:agent-gc": "node scripts/check-agent-gc.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "pnpm lint && pnpm check:harness && pnpm check:agent-gc && pnpm test && pnpm build && pnpm check:bundle && pnpm test:rust",
    "format": "pnpm format:rust",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
